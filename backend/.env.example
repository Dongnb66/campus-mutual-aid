# 复制本文件为 .env 并填写你的 DeepSeek API Key
DEEPSEEK_API_KEY=请填写你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# JWT 签名密钥：正式演示请改为足够长的随机字符串（例如 32 位以上随机串）
JWT_SECRET=please_change_to_a_long_random_string
PORT=3001

# ============ 缓存后端 ============
# 不配置 → 内存缓存（TTL+LRU+穿透防护，零依赖可跑）
# 配置后 → 真实 Redis（连接失败会自动降级内存并在启动日志说明）
# 本机示例：REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=

# ============ 数据库引擎（双驱动）============
# 默认 sqlite：node:sqlite 内置模块，零配置可跑（backend/campus.db）
# mysql：mysql2 驱动连 MySQL/MariaDB（表结构自动创建；连不上自动降级 sqlite）
#   DB_DRIVER=mysql
#   MYSQL_URL=mysql://root:密码@127.0.0.1:3306/campus
DB_DRIVER=
MYSQL_URL=

# ============ 腾讯云短信（SMS）============
# 5 项全部填了才会真实下发；缺任意一项自动降级为「演示模式」
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SMS_SDK_APP_ID=
# 需先在腾讯云控制台申请并通过审核的签名
TENCENTCLOUD_SMS_SIGN_NAME=CampusWall
TENCENTCLOUD_SMS_TEMPLATE_ID=
TENCENTCLOUD_SMS_REGION=ap-guangzhou
SMS_DRY_RUN=0    # 设 1 只打印请求体，不真正发送（不扣费）

# ============ 邮件（SMTP）============
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============ 微信 / QQ 开放平台（未配置则 mock 扫码）============
WECHAT_APPID=
WECHAT_SECRET=
QQ_APPID=
QQ_SECRET=
QQ_REDIRECT=
